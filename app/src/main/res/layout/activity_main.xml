<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.rawcam.nativepro.AutoFitTextureView
        android:id="@+id/texture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="top|center_horizontal" />

    <TextView
        android:id="@+id/timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="40dp"
        android:background="#99000000"
        android:paddingLeft="12dp"
        android:paddingTop="4dp"
        android:paddingRight="12dp"
        android:paddingBottom="4dp"
        android:text="REC 00:00"
        android:textColor="#FF5252"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B3000000"
        android:orientation="vertical"
        android:padding="10dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="200dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/spBitrate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <Spinner
                        android:id="@+id/spFps"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swRaw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="RAW ISP (no sharpen / min noise reduction)"
                    android:textColor="#FFFFFF" />

                <Switch
                    android:id="@+id/swMic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Pro audio (UNPROCESSED mic)"
                    android:textColor="#FFFFFF" />

                <Switch
                    android:id="@+id/swManual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Manual exposure"
                    android:textColor="#FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvIso"
                        android:layout_width="110dp"
                        android:layout_height="wrap_content"
                        android:text="ISO"
                        android:textColor="#FFFFFF" />

                    <SeekBar
                        android:id="@+id/sbIso"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swBoost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Boosted ISO (post-RAW boost)"
                    android:textColor="#FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvShutter"
                        android:layout_width="110dp"
                        android:layout_height="wrap_content"
                        android:text="Shutter"
                        android:textColor="#FFFFFF" />

                    <SeekBar
                        android:id="@+id/sbShutter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="9" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swFocus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Manual focus"
                    android:textColor="#FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvFocus"
                        android:layout_width="110dp"
                        android:layout_height="wrap_content"
                        android:text="Focus"
                        android:textColor="#FFFFFF" />

                    <SeekBar
                        android:id="@+id/sbFocus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swAwb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="White balance lock"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPhoto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PHOTO" />

            <Button
                android:id="@+id/btnRecord"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RECORD" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
